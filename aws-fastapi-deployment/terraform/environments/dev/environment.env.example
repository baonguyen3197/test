# Copy to environment.env, replace the values, then run:
#   source environments/dev/environment.env

export AWS_PROFILE=fastapi-aws
export AWS_REGION=ap-southeast-1
export AWS_DEFAULT_REGION=ap-southeast-1
export AWS_PAGER=

export TF_VAR_name=fastapi-aws
export TF_VAR_vpc_cidr=10.40.0.0/16
export TF_VAR_certificate_domain_name=fastapi-app.com
export TF_VAR_db_engine_version=REPLACE_WITH_SUPPORTED_VERSION
export TF_VAR_db_instance_class=db.m6gd.large
export TF_VAR_tasks_per_az=0

# Optional account guard. Uncomment only after confirming the active account.
# export TF_VAR_aws_account_id=123456789012

# Backend configuration is not a Terraform input variable. The AWS account ID
# makes this bucket name globally distinct for the active profile.
export STATE_BUCKET="test-fastapi-bucket-$(aws sts get-caller-identity --query Account --output text)"
